{
  "version": 1,
  "description": "Dry-run catalog for every reusable CI template. Each entry builds a consumer fixture, runs GitLab CI Lint (dry_run + include_jobs), and asserts expected jobs/stages/script markers.",
  "templates": [
    {
      "id": "common-node24",
      "template": "templates/common/node24.yml",
      "stages": ["lint"],
      "jobs": [
        {
          "name": "preflight:node24",
          "extends": ".node24_base",
          "stage": "lint",
          "script": ["pnpm -v"],
          "script_contains": ["pnpm -v"]
        }
      ],
      "expected_merged": [".node24_base", "preflight:node24"]
    },
    {
      "id": "lint-prettier",
      "template": "templates/lint/prettier.yml",
      "stages": ["lint"],
      "jobs": [
        {
          "name": "lint:prettier",
          "extends": ".lint_prettier",
          "stage": "lint",
          "script_contains": ["prettier@"]
        }
      ],
      "expected_merged": [".node24_base", ".lint_prettier", "lint:prettier"]
    },
    {
      "id": "lint-eslint",
      "template": "templates/lint/eslint.yml",
      "stages": ["lint"],
      "jobs": [
        {
          "name": "lint:eslint",
          "extends": ".lint_eslint",
          "stage": "lint",
          "script_contains": ["pnpm install"]
        }
      ],
      "expected_merged": [".node24_base", ".lint_eslint", "lint:eslint"]
    },
    {
      "id": "lint-yaml",
