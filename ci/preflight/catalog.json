  "examples": [
    {
      "id": "example-node-app",
      "path": "examples/node-app.gitlab-ci.yml",
      "rewrite_project_to_local": true,
      "force_jobs": [
        {"name": "lint:prettier", "extends": ".lint_prettier", "stage": "lint"},
        {"name": "lint:eslint", "extends": ".lint_eslint", "stage": "lint"},
        {"name": "node:test", "extends": ".node_test", "stage": "test"},
        {"name": "node:build", "extends": ".node_build", "stage": "build"},
        {"name": "security:gitleaks", "extends": ".security_gitleaks", "stage": "validate"},
        {"name": "security:osv-scanner", "extends": ".security_osv_scanner", "stage": "validate"}
      ],
      "expected_jobs": [
        "lint:prettier",
        "lint:eslint",
        "node:test",
        "node:build",
        "security:gitleaks",
        "security:osv-scanner"
      ]
    },
    {
      "id": "example-multi-registry",
      "path": "examples/multi-registry.gitlab-ci.yml",
      "rewrite_project_to_local": true,
      "force_jobs": [
        {"name": "security:gitleaks", "extends": ".security_gitleaks", "stage": "validate"},
        {"name": "container:build-push", "extends": ".container_build_push", "stage": "build"},
        {"name": "container:trivy-image-scan", "extends": ".container_trivy_image_scan", "stage": "scan"},
        {"name": "container:syft-sbom", "extends": ".container_syft_sbom", "stage": "scan"}
      ],
      "expected_jobs": [
        "security:gitleaks",
        "container:build-push",
        "container:trivy-image-scan",
        "container:syft-sbom"
      ]
    },
    {
      "id": "example-harbor-only",
      "path": "examples/harbor-only-pipeline.gitlab-ci.yml",
      "rewrite_project_to_local": true,
      "force_jobs": [
        {"name": "security:gitleaks", "extends": ".security_gitleaks", "stage": "validate"},
        {"name": "container:harbor-build-push", "extends": ".container_harbor_build_push", "stage": "build"},
        {"name": "container:trivy-image-scan", "extends": ".container_trivy_image_scan", "stage": "scan"},
        {"name": "container:syft-sbom", "extends": ".container_syft_sbom", "stage": "scan"},
        {"name": "container:cosign-sign", "extends": ".container_cosign_sign", "stage": "publish"}
      ],
      "expected_jobs": [
        "security:gitleaks",
        "container:harbor-build-push",
        "container:trivy-image-scan",
        "container:syft-sbom",
        "container:cosign-sign"
      ]
    },
    {
      "id": "example-container",
      "path": "examples/container-pipeline.gitlab-ci.yml",
      "rewrite_project_to_local": true,
      "force_jobs": [
        {"name": "lint:yaml", "extends": ".lint_yaml", "stage": "lint"},
        {"name": "security:gitleaks", "extends": ".security_gitleaks", "stage": "validate"},
        {"name": "container:build", "extends": ".container_build", "stage": "build"},
        {"name": "container:trivy-image-scan", "extends": ".container_trivy_image_scan", "stage": "scan"},
        {"name": "container:syft-sbom", "extends": ".container_syft_sbom", "stage": "scan"},
        {"name": "container:container-scan", "extends": ".container_scan", "stage": "scan"},
        {"name": "container:cosign-sign", "extends": ".container_cosign_sign", "stage": "publish"},
        {"name": "container:harbor-push", "extends": ".container_harbor_push", "stage": "publish"}
      ],
      "expected_jobs": [
        "lint:yaml",
        "security:gitleaks",
        "container:build",
        "container:trivy-image-scan",
        "container:syft-sbom",
        "container:container-scan",
        "container:cosign-sign",
        "container:harbor-push"
